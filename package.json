    "seed:villages": "node scripts/generate-villages-seed.mjs",
    "seed:site-content": "node scripts/generate-site-content-seed.mjs",
    "db:bootstrap:sql": "node -e \"const fs=require('node:fs');const path=require('node:path');const root=process.cwd();const files=['supabase/villages.schema.sql','supabase/villages.seed.sql','supabase/site-content.seed.sql'];const out=files.map((file)=>fs.readFileSync(path.join(root,file),'utf8').trim()).join('\\n\\n');fs.writeFileSync(path.join(root,'supabase/bootstrap-all.sql'),`${out}\\n`);console.log('Wrote supabase/bootstrap-all.sql');\"",
    "db:setup:villages": "node scripts/setup-villages-db.mjs"
  },
